{
  "extends": [
    "@tsconfig/node-lts/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "exclude": ["**/*.cjs"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    // tsup's skipNodeModulesBundle only bundles imports matched by this map;
    // without it, esbuild leaves "#*" imports unresolved in dist output.
    "paths": {
      "#*": ["./src/*"]
    }
  }
}
