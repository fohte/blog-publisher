{
  "openapi": "3.1.0",
  "info": {
    "title": "blog-publisher",
    "version": "1"
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/notes": {
      "get": {
        "responses": {
          "200": {
            "description": "note list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "docId": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "enum": ["new", "update"]
                      },
                      "mtime": {
                        "type": "integer"
                      }
                    },
                    "required": ["docId", "path", "title", "kind", "mtime"]
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/plan": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "docIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": ["docIds"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "plan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "signature": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "docId": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": ["added", "modified", "skipped"]
                          },
                          "slug": {
                            "type": "string"
                          },
                          "publishedFilename": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "summary": {
                            "type": "string"
                          },
                          "diffStat": {
                            "type": "object",
                            "properties": {
                              "added": {
                                "type": "integer"
                              },
                              "removed": {
                                "type": "integer"
                              }
                            },
                            "required": ["added", "removed"]
                          },
                          "skipReason": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "docId",
                          "kind",
                          "slug",
                          "publishedFilename",
                          "title",
                          "summary"
                        ]
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "docId": {
                            "type": "string"
                          },
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": ["docId", "code", "message"]
                      }
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "docId": {
                            "type": "string"
                          },
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": ["docId", "code", "message"]
                      }
                    },
                    "imagesToUpload": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sourcePath": {
                            "type": "string"
                          },
                          "hash": {
                            "type": "string"
                          },
                          "alreadyUploaded": {
                            "type": "boolean"
                          }
                        },
                        "required": ["sourcePath", "hash", "alreadyUploaded"]
                      }
                    }
                  },
                  "required": [
                    "signature",
                    "items",
                    "warnings",
                    "errors",
                    "imagesToUpload"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/apply": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "docIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": ["docIds"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "apply result",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": ["success"]
                        },
                        "prNumber": {
                          "type": "integer"
                        },
                        "prUrl": {
                          "type": "string",
                          "format": "uri"
                        },
                        "branch": {
                          "type": "string"
                        }
                      },
                      "required": ["kind", "prNumber", "prUrl", "branch"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": ["planChanged"]
                        },
                        "newPlan": {
                          "type": "object",
                          "properties": {
                            "signature": {
                              "type": "string"
                            },
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "docId": {
                                    "type": "string"
                                  },
                                  "kind": {
                                    "type": "string",
                                    "enum": ["added", "modified", "skipped"]
                                  },
                                  "slug": {
                                    "type": "string"
                                  },
                                  "publishedFilename": {
                                    "type": "string"
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "summary": {
                                    "type": "string"
                                  },
                                  "diffStat": {
                                    "type": "object",
                                    "properties": {
                                      "added": {
                                        "type": "integer"
                                      },
                                      "removed": {
                                        "type": "integer"
                                      }
                                    },
                                    "required": ["added", "removed"]
                                  },
                                  "skipReason": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "docId",
                                  "kind",
                                  "slug",
                                  "publishedFilename",
                                  "title",
                                  "summary"
                                ]
                              }
                            },
                            "warnings": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "docId": {
                                    "type": "string"
                                  },
                                  "code": {
                                    "type": "string"
                                  },
                                  "message": {
                                    "type": "string"
                                  }
                                },
                                "required": ["docId", "code", "message"]
                              }
                            },
                            "errors": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "docId": {
                                    "type": "string"
                                  },
                                  "code": {
                                    "type": "string"
                                  },
                                  "message": {
                                    "type": "string"
                                  }
                                },
                                "required": ["docId", "code", "message"]
                              }
                            },
                            "imagesToUpload": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "sourcePath": {
                                    "type": "string"
                                  },
                                  "hash": {
                                    "type": "string"
                                  },
                                  "alreadyUploaded": {
                                    "type": "boolean"
                                  }
                                },
                                "required": [
                                  "sourcePath",
                                  "hash",
                                  "alreadyUploaded"
                                ]
                              }
                            }
                          },
                          "required": [
                            "signature",
                            "items",
                            "warnings",
                            "errors",
                            "imagesToUpload"
                          ]
                        }
                      },
                      "required": ["kind", "newPlan"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": ["alreadyApplied"]
                        },
                        "prNumber": {
                          "type": "integer"
                        },
                        "prUrl": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "required": ["kind", "prNumber", "prUrl"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": ["failed"]
                        },
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["kind", "code", "message"]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/prs": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": ["open", "closed", "all"]
            },
            "required": false,
            "name": "state",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "pr list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "integer"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "branch": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string",
                        "enum": ["open", "closed"]
                      },
                      "title": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "mergedAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "number",
                      "url",
                      "branch",
                      "state",
                      "title",
                      "createdAt"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/prs/{number}/cancel": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+$"
            },
            "required": true,
            "name": "number",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "closed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "closed": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  },
                  "required": ["closed"]
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/prs/{number}/ci": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+$"
            },
            "required": true,
            "name": "number",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "ci status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": ["pending", "success", "failure"]
                    },
                    "failedChecks": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "previewUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": ["state", "failedChecks"]
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    }
  }
}
